# Copier ce fichier en .env et remplacer par ta chaîne de connexion.
# Supabase : bouton "Connect" en haut du projet -> "Session pooler" (compatible IPv4)
# Remplacer [YOUR-PASSWORD] par le mot de passe de la base.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
